{
  "manifest_version": 3,
  "name": "OpenDown Integration Module",
  "version": "1.0.0",
  "description": "Browser integration for the OpenDown download manager: media auto-grabber, context-menu downloads, and download takeover.",
  "permissions": ["contextMenus", "webRequest", "storage", "tabs", "downloads", "cookies"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "OpenDown",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
